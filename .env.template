# Lumina Auth - Environment Variables Template

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/

# Flask JWT Secret Key (generate a strong hex string for production)
JWT_SECRET_KEY=your_jwt_secret_key_here

# Password Hashing HMAC Key
PASSWORD_HMAC_KEY=my_super_secret_password_signature_key

# Twilio Credentials for SMS Gateway
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
